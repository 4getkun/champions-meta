# 手元だけで使う秘密の値。これを .env という名前で写して値を書く（.env は .gitignore 済みで、コミットされない）。
# GitHub へは scripts/set-secrets.ps1 で登録する（リポジトリの secrets。deploy.yml が使う）。

# Cloudflare の API トークン（権限: アカウント → Cloudflare Pages → 編集。対象は自分のアカウントだけ）
CLOUDFLARE_API_TOKEN=
# Cloudflare のアカウント ID（ダッシュボードの URL の dash.cloudflare.com/ の直後の 32 文字）
CLOUDFLARE_ACCOUNT_ID=

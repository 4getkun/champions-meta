# Cloudflare Pages の応答ヘッダー。データは定期更新するので、控えは短く（画面は cache: 'no-cache' で読み直す）
/data/*
  Cache-Control: public, max-age=300
/*.js
  Cache-Control: public, max-age=300
/*.css
  Cache-Control: public, max-age=300
# 書体は名前に中身のハッシュが入っているので、長く控えてよい
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
